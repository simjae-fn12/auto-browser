<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>oinzi</AssemblyName>
    <Product>Oinzi</Product>
    <Title>Oinzi</Title>
    <Version>0.9.1</Version>
    <ApplicationIcon>oinzi.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="chrome\chrome.html" LogicalName="chrome.html" />
    <EmbeddedResource Include="oinzi.ico" LogicalName="oinzi.ico" />
    <EmbeddedResource Include="agent.mjs" LogicalName="agent.mjs" />
    <EmbeddedResource Include="mcp.mjs" LogicalName="mcp.mjs" />
    <EmbeddedResource Include="assistant\activity.js" LogicalName="activity.js" />
    <EmbeddedResource Include="assistant\INSTRUCTIONS.md" LogicalName="assistant.md" />
    <EmbeddedResource Include="skills\**\SKILL.md" LogicalName="skills/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

</Project>
